{
  "name": "clubcenter-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Solo el dominio propio (la cookie del panel es del dominio)
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Builds corre solo `wrangler deploy`: esto compila antes
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Rutas de React Router (/horarios, /eventos/x) caen en index.html
    "not_found_handling": "single-page-application",
    // El Worker corre para la API y las páginas (les inserta el contenido de D1).
    // JS, CSS e imágenes los sirve Cloudflare directo, sin pasar por el Worker
    "run_worker_first": ["/*", "!/assets/*", "!/Fotos/*", "!/robots.txt"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ccfa", "database_id": "248df70e-9aaf-47d8-9b2b-b93ef5683403" }
  ],
  "vars": {
    // Check-in de socios (plan.md). Vacía = todavía no hay BiFrost: /checkin responde "no disponible"
    "BIFROST_URL": "",
    // Solis 1213, CABA (OpenStreetMap): para verificar que el socio esté en el club al hacer check-in
    "CLUB_LAT": "-34.6229137",
    "CLUB_LNG": "-58.3899370"
  }
  // Secrets (no van acá; npx wrangler secret put <NOMBRE>):
  //   ADMIN_PASSWORD  contraseña del panel /admin
  //   SOCIO_SECRET    firma de las sesiones de socios (cualquier texto largo y aleatorio)
  //   CHECKIN_CODIGO  código que va en el QR de recepción
  //   BIFROST_TOKEN   token de servicio para llamar a BiFrost
}
