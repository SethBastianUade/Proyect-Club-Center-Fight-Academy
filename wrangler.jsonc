{
  "name": "ccfa",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Solo el dominio propio (la cookie del panel es del dominio)
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Builds corre solo `wrangler deploy`: esto compila antes
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Rutas de React Router (/horarios, /eventos/x) caen en index.html
    "not_found_handling": "single-page-application",
    // El Worker solo corre para la API; el resto lo sirve Cloudflare directo
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ccfa", "database_id": "248df70e-9aaf-47d8-9b2b-b93ef5683403" }
  ]
  // Contraseña del panel /admin (secret, no va acá): npx wrangler secret put ADMIN_PASSWORD
}
